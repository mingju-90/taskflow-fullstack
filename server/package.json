{
  "name": "taskflow-server",
  "version": "0.0.0",
  "private": true,
  "description": "TaskFlow 后端服务",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
